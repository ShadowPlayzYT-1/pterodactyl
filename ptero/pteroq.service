# Pterodactyl Queue Worker - systemd service file
# Reference only. The installer starts the queue worker with nohup
# in non-systemd environments (Codespaces, Docker, WSL).
#
# Place at: /etc/systemd/system/pteroq.service (on systemd systems)
# Enable:   systemctl enable --now pteroq

[Unit]
Description=Pterodactyl Queue Worker
After=redis-server.service

[Service]
User=www-data
Group=www-data
Restart=always
ExecStart=/usr/bin/php /var/www/pterodactyl/artisan queue:work --queue=high,standard,low --sleep=3 --tries=3
StartLimitInterval=180
StartLimitBurst=30
RestartSec=5s

[Install]
WantedBy=multi-user.target
